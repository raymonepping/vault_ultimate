# The console API: Node 24 and its one dependency, pg (D18: the witness logs
# in to PostgreSQL). It runs no Vault CLI: act 1's Secrets Import runs in a
# throwaway Vault container on the host's side (ansible/act-1.yml).
ARG NODE_IMAGE=docker.io/library/node:24-alpine
# pg from the lockfile, never from the Mac's node_modules.
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json server.js ./
COPY lib ./lib
COPY bin ./bin
# config/story.json without the legacy values (scripts/app-build.sh strips them).
COPY config ./config

USER 1000:1000
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=4s --retries=6 --start-period=10s \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "server.js"]
