ARG NODE_IMAGE=docker.io/library/node:24-alpine
ARG NGINX_IMAGE=docker.io/library/nginx:1.30.0-alpine

FROM ${NODE_IMAGE} AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM ${NGINX_IMAGE}
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist /usr/share/nginx/html

# uid 101 is nginx; volume-init gives it the certificate and key.
USER 101

EXPOSE 8443

# Plain-HTTP health listener on 8080, never published.
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -qO /dev/null http://127.0.0.1:8080/nginx-health || exit 1
