# Tidewell's booking application. One dependency, pg, pinned by
# package-lock.json (the same version vault_identity uses).
ARG NODE_IMAGE=docker.io/library/node:24-alpine
FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY server.js ./
COPY lib ./lib
COPY public ./public
USER 1000:1000
EXPOSE 8443
HEALTHCHECK --interval=10s --timeout=4s --retries=6 --start-period=10s \
  CMD node -e "fetch('https://127.0.0.1:8443/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
