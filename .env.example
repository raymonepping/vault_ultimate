# .env: local values, never committed. `make env-init` copies this file to .env.
# Image pins, ports and names live in config/defaults.conf; override any of
# them here. The build reads only the two variables below from .env.
#
# The Vault Enterprise licence: the string itself, or a path to a .hclic file.
# `make license` installs it to .secrets/vault/vault.hclic (never printed).
VAULT_LICENSE=
# LocalStack's auth token (a free Hobby account at localstack.cloud). Compose
# hands it to the vult-localstack container; it is never written elsewhere.
LOCALSTACK_AUTH_TOKEN=
